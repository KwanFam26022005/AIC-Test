# Official caption model-stage environment.
# Copy outside the repository, for example:
# /tmp2/maitanha/vgu/ttn/AIC-Khoa/conda_envs/caption_official.env

AIC_ROOT=/tmp2/maitanha/vgu/ttn/AIC-Khoa/AIC-Test
PYTHONIOENCODING=utf-8
CUDA_VISIBLE_DEVICES=1

HF_HOME=/tmp2/maitanha/vgu/ttn/AIC-Khoa/conda_envs/hf_cache
HF_HUB_CACHE=/tmp2/maitanha/vgu/ttn/AIC-Khoa/conda_envs/hf_cache/hub
TRANSFORMERS_CACHE=/tmp2/maitanha/vgu/ttn/AIC-Khoa/conda_envs/hf_cache
TOKENIZERS_PARALLELISM=false
TRANSFORMERS_VERBOSITY=error
HF_HUB_DISABLE_SYMLINKS_WARNING=1
OMP_NUM_THREADS=4

CAPTION_VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
CAPTION_VLM_DTYPE=bfloat16
CAPTION_VLM_ATTN=sdpa

CAPTION_LLM_PROVIDER=transformers
CAPTION_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
CAPTION_LLM_DTYPE=bfloat16
CAPTION_LLM_ATTN=sdpa
CAPTION_LLM_DEVICE_MAP=auto
CAPTION_LLM_BATCH_SIZE=1
CAPTION_LLM_DO_SAMPLE=false
CAPTION_LLM_TEMPERATURE=0
CAPTION_LLM_MAX_INPUT_TOKENS=4096
CAPTION_LLM_MAX_RETRIES=2

CAPTION_FRAME_MAX_NEW_TOKENS=128
CAPTION_SHOT_MAX_NEW_TOKENS=512
CAPTION_TRAKE_MAX_NEW_TOKENS=384
CAPTION_CHECKPOINT_EVERY=10
CAPTION_MAX_FALLBACK_RATE=0.15
CAPTION_PROMPT_VERSION=caption_qwen25_official_v1
CAPTION_PROMPT_DIR=${AIC_ROOT}/data_processing/caption/caption_pipeline/prompts
