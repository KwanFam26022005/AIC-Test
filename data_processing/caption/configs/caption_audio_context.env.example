# Caption audio-context pipeline v2
# Copy this file to /tmp2/maitanha/vgu/ttn/AIC-Khoa/conda_envs/caption_audio_context.env

AIC_ROOT=/tmp2/maitanha/vgu/ttn/AIC-Khoa/AIC-Test
PYTHONIOENCODING=utf-8

# Pick the physical GPU before launching the command:
# CUDA_VISIBLE_DEVICES=0

# Attention backend. The runtime falls back to sdpa/eager if flash-attn is ABI-incompatible.
CAPTION_VLM_ATTN=flash_attention_2
CAPTION_LLM_ATTN=flash_attention_2
